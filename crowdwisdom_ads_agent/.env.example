# ── LLM Provider ──────────────────────────────────────────────
# Get your free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free model options (pick one):
#   mistralai/mistral-7b-instruct:free
#   meta-llama/llama-3-8b-instruct:free
#   google/gemma-7b-it:free
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ── Apify (Data Scraping) ──────────────────────────────────────
# Get your free token at https://apify.com
APIFY_API_TOKEN=your_apify_api_token_here

# ── Google Drive (Optional – for Agent 3) ─────────────────────
# Path to your service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
# The Google Drive folder ID containing your brand data
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ── CrowdWisdomTrading Config ──────────────────────────────────
TARGET_NICHE=trading
TARGET_URL=https://crowdwisdomtrading.com

# ── Output Paths ──────────────────────────────────────────────
OUTPUT_DIR=output
LOGS_DIR=logs
